    {
      "channel_group": "PT_CAN_100Hz",
      "column_type": "double",
      "dtype": "float32",
      "enum_map": null,
      "notes": "Road curvature at the ego position, signed, positive = left bend, radius 1/|kappa|. A prescribed scenario parameter, quantised to sensor.quantisation.curv_1pm. Emitted so a checker can recompute path-relative lateral offsets itself.",
      "quantisation": 1e-05,
      "raster_hz": 100,
      "role": "stimulus",
