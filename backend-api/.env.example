# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Topic names (from your Quix environment)
config_input=config-updates
uploads_output=test-data-uploads

# MongoDB connection
MONGO_URI=mongodb://admin:mongo_password@mongodb:27017/testmanager?authSource=admin

# Optional: blob storage / lakehouse (only present when bound to the deployment)
Quix__BlobStorage__Connection__Json=
Quix__Lakehouse__Query__Url=
Quix__Lakehouse__Query__AuthToken=
