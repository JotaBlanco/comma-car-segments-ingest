# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Topics (spec 4.1). The API only produces; every consumer sets earliest itself.
trace_ingest_requests=trace-ingest-requests
evaluation_requests=evaluation-requests
test_results=test-results
run_summaries=run-summaries
report_completed=report-completed
config_events=config-events

# MongoDB connection
MONGO_HOST=mongodb:27017
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_DB_NAME=testmanager

# Blob seam. "auto" uses the Quix filesystem when the platform injected
# credentials, else the local filesystem below, else nothing (endpoints that need
# blob then return 503 naming the cause).
TM_BLOB_BACKEND=auto
TM_BLOB_LOCAL_ROOT=.blobstore
TM_MAX_UPLOAD_BYTES=536870912
TM_FRONTEND_BASE_URL=

# Injected by the platform when blobStorage.bind is enabled; absent today because
# the testrig Storage Gateway is unreachable.
Quix__BlobStorage__Connection__Json=

# Lakehouse Query API. On dev these inject only together with the blob bind, so
# declare them explicitly while the bind is disabled.
Quix__Lakehouse__Query__Url=
Quix__Lakehouse__Query__AuthToken=

LOGLEVEL=INFO
