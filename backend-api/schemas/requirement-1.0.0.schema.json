{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acc-project.local/schemas/requirement-1.0.0.schema.json",
  "title": "ACC system requirement (canonical)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "chapter", "text", "ears_pattern", "system_states",
    "rationale", "source", "verification_tag", "verification_method", "measurand", "status",
    "revision", "figure_refs", "related_reqs", "verified_by"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "maxLength": 20, "pattern": "^ACC-SYS-(FUN|PRF|SAF)-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "chapter": { "enum": ["Functional-HMI", "Performance", "Safety-Fault-Handling"] },
    "text": { "type": "string", "minLength": 1 },
    "ears_pattern": { "enum": ["Ubiquitous", "StateDriven", "EventDriven", "OptionalFeature",
      "UnwantedBehaviour", "Complex"] },
    "system_states": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["Off", "Standby", "Active-Cruise", "Active-Follow", "Active-Hold",
        "Driver-Override", "Degraded-Fault"] }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "source": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 200 } },
    "verification_tag": { "enum": ["VERIFIED-PRIMARY", "VERIFIED-SECONDARY", "UNVERIFIED-2018",
      "DERIVED"] },
    "verification_method": { "enum": ["Test", "Analysis", "Inspection", "Demonstration"] },
    "measurand": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "unit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": ["string", "null"] }
        }
      }
    },
    "status": { "enum": ["Draft", "Reviewed", "Approved", "Rejected", "Obsolete"] },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "figure_refs": { "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F[1-6]$" } },
    "related_reqs": { "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ACC-SYS-(FUN|PRF|SAF)-[0-9]{3}$" } },
    "verified_by": { "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ACC-SYS-TC-[0-9]{3}$" } }
  },
  "allOf": [
    { "if": { "properties": { "verification_method": { "const": "Test" } } },
      "then": { "properties": { "measurand": { "minItems": 1 } } } },
    { "if": { "properties": { "ears_pattern": { "enum": ["StateDriven", "Complex"] } } },
      "then": { "properties": { "system_states": { "minItems": 1 } } } }
  ]
}
