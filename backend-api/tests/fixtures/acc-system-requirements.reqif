            <SPEC-OBJECT-TYPE-REF>ST-ACC-SYS-REQ</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="_4746d062-c2d4-5502-bfe4-38ccea1af7f6" LONG-NAME="ACC-SYS-FUN-022" LAST-CHANGE="2026-08-18T00:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-FUN-022">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Automatic transition between control modes">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-TITLE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-CHAPTER</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-CH-FUNCTIONAL-HMI</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>While the ACC system is in the Active-Cruise state or the Active-Follow state, the ACC system shall change between speed control and following control without driver input.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-EARS-PATTERN</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-EARS-STATEDRIVEN</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-SYSTEM-STATES</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-CRUISE</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-FOLLOW</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>ISO 15622:2018 cl. 6.2.1 states verbatim that the transition between the control modes, following controlled or speed controlled, shall be made automatically, and cl. 6.1 states that the change between the two control modes is made automatically by the ACC system. Read from the publisher-hosted 2018 preview. This requirement carries only the automatic-transition obligation; which mode wins is carried by ACC-SYS-FUN-021 (INCOSE R19). The phrase "between speed control and following control" names the two endpoints of one transition, not two responses, so R20 is satisfied.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ISO 15622:2018 cl. 6.1; ISO 15622:2018 cl. 6.2.1">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-VERIFICATION-TAG</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-VT-PRIMARY</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-VERIFICATION-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-VM-TEST</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="acc_control_mode [enum]; target_detected [bool]; v_ego [m/s]">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-MEASURAND</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-STATUS</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-STAT-DRAFT</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="1.0">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-REVISION</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="F2">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-FIGURE-REFS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-FUN-021, ACC-SYS-FUN-023">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-RELATED-REQS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-VERIFIED-BY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>ST-ACC-SYS-REQ</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="_190dbc4c-61b1-5fe5-9c1b-87ebe50b035f" LONG-NAME="ACC-SYS-FUN-023" LAST-CHANGE="2026-08-18T00:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-FUN-023">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Target vehicle selection among forward vehicles">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-TITLE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-CHAPTER</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-CH-FUNCTIONAL-HMI</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>While the ACC system is in the Active-Cruise state or the Active-Follow state and more than one forward vehicle is present in the subject vehicle lane, the ACC system shall select as the target vehicle the forward vehicle with the smallest clearance to the subject vehicle.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-EARS-PATTERN</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-EARS-STATEDRIVEN</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-SYSTEM-STATES</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-CRUISE</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-FOLLOW</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>ISO 15622:2018 cl. 6.1 states verbatim that if there is more than one forward vehicle, the one to be followed shall be selected automatically, and refers to cl. 6.2.3.3 for the selection detail; that sub-clause is past the truncation point of the publisher-hosted preview, so the selection criterion itself is project-owned. Smallest clearance is chosen because it is the criterion that makes the following-control requirements of ACC-SYS-PRF-001 and ACC-SYS-PRF-003 conservative for the closest vehicle. This rule also governs which vehicle becomes the target after a cut-in or a cut-out, so no separate reselection rule exists (INCOSE R32); the latency of a reselection is carried by ACC-SYS-PRF-062. Owned by the systems engineer, 2026-08-18.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ISO 15622:2018 cl. 6.1; PROJECT-CHOICE:systems-engineer">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-VERIFICATION-TAG</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-VT-DERIVED</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-VERIFICATION-METHOD</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-VM-TEST</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="target_id [enum]; d_clearance [m]; v_target [m/s]">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-MEASURAND</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-STATUS</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-STAT-DRAFT</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="1.0">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-REVISION</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="F3, F5">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-FIGURE-REFS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-FUN-021, ACC-SYS-PRF-062">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-RELATED-REQS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-VERIFIED-BY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>ST-ACC-SYS-REQ</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="_ec26f293-c429-544f-9d42-37c3612890b4" LONG-NAME="ACC-SYS-FUN-041" LAST-CHANGE="2026-08-18T00:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-FUN-041">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Accelerator pedal override precedence">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-TITLE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-CHAPTER</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-CH-FUNCTIONAL-HMI</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>While the driver accelerator pedal position requests a powertrain torque greater than the powertrain torque requested by the ACC system, the ACC system shall be in the Driver-Override state.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-EARS-PATTERN</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-EARS-STATEDRIVEN</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-SYSTEM-STATES</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-CRUISE</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-FOLLOW</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-HOLD</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-DRIVER-OVERRIDE</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>ISO 15622:2018 cl. 6.3.1 places driver override precedence in the standard, accelerator input taking priority over ACC engine control, but the clause is past the truncation point of the publisher-hosted preview and was read from the ISO/TC 204 community extract, a non-official source, hence VERIFIED-SECONDARY. The requirement is written as a state invariant rather than as an entry event and an exit event, so that one statement specifies both the entry to and the exit from the Driver-Override state without becoming compound (INCOSE R19). Overlap rule O5 places driver pedal override in the Functional chapter: the driver is commanding and nothing is wrong. Brake pedal input is handled by ACC-SYS-FUN-042 because its response is a different state.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ISO 15622:2018 cl. 6.3.1">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
