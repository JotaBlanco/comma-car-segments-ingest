        <SPEC-OBJECT IDENTIFIER="_5e14d3e4-5704-5cdf-a3a4-b29f72b50a18" LONG-NAME="ACC-SYS-PRF-002" LAST-CHANGE="2026-08-18T00:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ACC-SYS-PRF-002">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Selectable time gap setting range">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-TITLE</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-CHAPTER</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-CH-PERFORMANCE</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>The ACC system shall provide at least one selectable time gap setting within the range 1,5 s to 2,2 s for subject vehicle speeds greater than 8 m/s.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-EARS-PATTERN</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-EARS-UBIQUITOUS</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-SYSTEM-STATES</ATTRIBUTE-DEFINITION-ENUMERATION-REF>
              </DEFINITION>
              <VALUES>
                <ENUM-VALUE-REF>EV-ST-STANDBY</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-CRUISE</ENUM-VALUE-REF>
                <ENUM-VALUE-REF>EV-ST-ACTIVE-FOLLOW</ENUM-VALUE-REF>
              </VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-XHTML>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>ISO 15622:2018 cl. 6.2.3.1 states verbatim that at least one selectable time gap setting shall be in the range 1,5 s to 2,2 s for speeds greater than 8 m/s. Read from the publisher-hosted 2018 preview. The speed qualifier is new in the 2018 edition; the 2002 first edition carried the same band with no speed qualifier, so the qualifier is retained here to match the current edition. This requirement fixes the setting range only; the floor on the resulting time gap is ACC-SYS-PRF-001.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>AD-RATIONALE</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="ISO 15622:2018 cl. 6.2.3.1">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>AD-SOURCE</ATTRIBUTE-DEFINITION-STRING-REF>
