# Local development / demo values for docker-compose.yml.
#
# Every variable here has the SAME value baked into docker-compose.yml as a
# default (${VAR:-default}), so "docker compose up" works with or without this
# file. scripts/dev.sh passes it with --env-file so a change here takes effect
# without editing the compose file.
#
# This file is committed on purpose: it contains no secret. The Mongo password is
# the throwaway value quix.yaml already uses for the dev environment, and there is
# no Quix SDK token, blob credential or lakehouse token in the local stack.
#
# Variable names are taken from the applications' own .env.example files and from
# quix.yaml; nothing here is invented.

# --- host ports -------------------------------------------------------------
# The container ports are fixed by the images (backend 80, frontend 80, DCM 80).
BACKEND_PORT=8000
FRONTEND_PORT=8501
DCM_PORT=8002
MONGO_PORT=27017
REDPANDA_EXTERNAL_PORT=19092
CONSOLE_PORT=8080

# --- MongoDB ----------------------------------------------------------------
# Consumed as MONGO_INITDB_ROOT_USERNAME / _PASSWORD by mongodb, and as
# MONGO_USER / MONGO_PASSWORD by backend-api (db.py:build_mongo_uri) and
# mongo-writer (main.py:build_sink, authSource=admin).
MONGO_USER=admin
MONGO_PASSWORD=mongo_password
MONGO_DB_NAME=testmanager

# --- image versions ---------------------------------------------------------
REDPANDA_VERSION=v24.2.7
REDPANDA_CONSOLE_VERSION=v2.7.2

# --- logging ----------------------------------------------------------------
LOGLEVEL=INFO

# --- Lakehouse (intentionally empty locally) --------------------------------
# There is no local Iceberg catalog and no local Query API. Empty means
# backend-api /health and tm-evaluator both report the Lakehouse as unavailable
# with the reason, instead of pretending. Fill these in ONLY if you are pointing
# the local stack at a real Quix environment.
QUIX_LAKEHOUSE_QUERY_URL=
QUIX_LAKEHOUSE_QUERY_TOKEN=

# --- test-vectors-sink (profile: lakehouse) ---------------------------------
# Required by QuixTSDataLakeSink and unavailable locally. Left empty, the sink
# fails its client connect and exits; see the comment on that service in
# docker-compose.yml and the capability table in docs/LOCAL_DEVELOPMENT.md.
QUIX_WORKSPACE_ID=
QUIX_BLOBSTORAGE_CONNECTION_JSON=
QUIX_LAKEHOUSE_CATALOG_URL=
QUIX_LAKEHOUSE_CATALOG_TOKEN=

# --- seed / demo paths (used by scripts/seed-demo.sh, not by compose) -------
# The sibling plant repo: real ReqIF, real canonical JSON, 37 real MF4 files.
ACC_PROJECT_DIR=C:/repos/acc_project
