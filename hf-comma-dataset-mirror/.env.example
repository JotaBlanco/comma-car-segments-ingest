# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# Hugging Face dataset to mirror
HF_DATASET_REPO_ID=commaai/commaCarSegments
HF_REPO_TYPE=dataset

# Destination prefix (folder) in blob storage
BLOB_DEST_PREFIX=commacarsegments/

# Skip files that already exist at the destination
SKIP_EXISTING=true

# Optional Hugging Face access token (only needed for gated/private datasets)
HF_TOKEN=
