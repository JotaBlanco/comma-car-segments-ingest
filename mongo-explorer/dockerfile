# Mongoku, pointed at the Configuration DB with the same credentials the Configuration Manager
# uses. The image takes one connection URL; this entrypoint builds it from the user and the
# password so the password stays a plain secret and is never spelled inside a URL anywhere.
FROM huggingface/mongoku:1.3.0
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
