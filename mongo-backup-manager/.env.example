# Quix SDK Token - find this in the Quix Portal under Settings > Tokens (SDK Tokens section)
Quix__Sdk__Token=

# MongoDB connection
MONGO_URI=mongodb://admin:mongo_password@mongodb:27017/testmanager?authSource=admin

# Backup schedule
BACKUP_INTERVAL_HOURS=24

# Optional: blob storage (only present when bound to the deployment)
Quix__BlobStorage__Connection__Json=
